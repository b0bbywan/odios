systemd:
  enabled: true
  system:
{% if install_bluetooth %}
    - name: bluetooth.service
{% endif %}
  user:
{% if install_audioserver %}
    - name: {{ odio_api_audioserver_unit[audioserver] }}
{% endif %}
{% if install_mpd or install_mpd_discplayer %}
    - name: mpd.service
{% if install_mympd %}
      url: ":{{ mpd_mympd_http_port }}"
      open: self
{% endif %}
{% endif %}
{% if install_mpd_discplayer %}
    - name: mpd-discplayer.service
{% endif %}
{% if install_shairport_sync %}
    - name: shairport-sync.service
{% endif %}
{% if install_snapclient %}
    - name: snapclient.service
{% if odio_api_snapweb_url is defined %}
      url: "{{ odio_api_snapweb_url }}"
      open: panel
{% endif %}
{% endif %}
{% if install_spotifyd %}
    - name: spotifyd.service
      url: "https://open.spotify.com"
      open: tab
{% endif %}
{% if install_qbzd %}
    - name: qbzd.service
      url: "https://play.qobuz.com/"
      open: tab
{% endif %}
{% if install_upmpdcli %}
    - name: upmpdcli.service
{% endif %}
{% if install_display %}
    - name: odio-screen.service
{% endif %}
