[Unit]
Description=Snapcast client
Documentation=man:snapclient(1)
Wants=network-online.target avahi-daemon.service
After=network-online.target time-sync.target sound.target avahi-daemon.service

[Service]
EnvironmentFile=%h/.config/snapclient/snapclient.conf
ExecStart=/usr/bin/snapclient --logsink=system $SNAPCLIENT_OPTS
# very noisy on stdout
StandardOutput=null
Restart=on-failure
StartupCPUWeight=20

[Install]
WantedBy=default.target
