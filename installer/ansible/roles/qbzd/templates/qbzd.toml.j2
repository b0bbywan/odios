# qbzd daemon config
# Generated by Ansible
#
# Player settings (audio backend, Qobuz Connect) live in SQLite under
# ~/.local/share/qbzd/ — the role applies those with `qbzd settings set`.

[server]
# Localhost-only: the control plane has no auth unless a token is set.
bind = "127.0.0.1"
port = {{ qbzd_http_port }}

[log]
level = "info"

[mpris]
enabled = true
